# Copy this file to config.env only when you need to change the defaults.
SCHOLARSCOPE_HOST=127.0.0.1
SCHOLARSCOPE_PORT=5180
SCHOLARSCOPE_API_HOST=127.0.0.1
SCHOLARSCOPE_API_PORT=5181

# Optional: choose the system Python used to create the package-local venv.
# SCHOLARSCOPE_PYTHON=python3
# SCHOLARSCOPE_NODE_BIN=/usr/bin/node

# Optional: pip source for the first-run Python engine install.
# The launcher defaults to official PyPI even if the server has a different
# global pip mirror configured. Use your reachable mirror if PyPI is blocked.
# SCHOLARSCOPE_PIP_INDEX_URL=https://pypi.org/simple
# SCHOLARSCOPE_PIP_EXTRA_INDEX_URL=
