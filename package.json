{
  "name": "scholarscope-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm --workspace scholarscope-desktop run dev",
    "build": "npm --workspace scholarscope-desktop run build",
    "lint": "npm --workspace scholarscope-desktop run lint",
    "test": "npm --workspace scholarscope-desktop run test",
    "preview": "npm --workspace scholarscope-desktop run preview",
    "tauri": "npm --workspace scholarscope-desktop run tauri --",
    "tauri:dev": "npm --workspace scholarscope-desktop run tauri:dev --",
    "tauri:build": "npm --workspace scholarscope-desktop run tauri:build --"
  }
}
